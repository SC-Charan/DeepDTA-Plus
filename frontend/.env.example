# DeepDTA-Plus Environment Configuration
# External PyTorch FastAPI Backend URL (Defaults to localhost or deployed server)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Application Metadata
NEXT_PUBLIC_APP_NAME="DeepDTA-Plus"
NEXT_PUBLIC_APP_VERSION="1.0.0"

# Set to "true" to automatically fall back to high-fidelity client-side ML mock if backend is offline
NEXT_PUBLIC_FALLBACK_MOCK=true
